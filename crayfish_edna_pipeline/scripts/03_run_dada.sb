#!/bin/bash --login

#SBATCH --job-name=dada2
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=24:00:00

source "${PIPELINE_DIR}/config/config.sh"

export PROJECT_DIR
export TRIM_DIR
export DADA2_DIR
export PLOT_DIR
export REFERENCE_DB

module purge
module load R-bundle-Bioconductor/3.18-foss-2023a-R-4.3.2

mkdir -p "$DADA2_LOG_DIR"
mkdir -p "$DADA2_DIR"
mkdir -p "$DADA2_DIR/filtered"
mkdir -p "$PLOT_DIR"

Rscript scripts/dada2_pipeline.R